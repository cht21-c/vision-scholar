# Copy to .env only when configuring your own provider.
# offline: paper search/experiments work; no model calls.
# openai: OpenAI-compatible /v1 endpoint; anthropic: Anthropic-compatible endpoint.
# mock: explicitly labeled fixed-script demo, NOT a real model.
VS_PROVIDER=offline
VS_MODEL=
VS_BASE_URL=
VS_API_KEY=
VS_RUN_TIMEOUT=180
VS_MAX_TURNS=10
# Optional absolute path. Defaults to ./data next to the source:
# VS_DATA_DIR=/absolute/path/to/vision-scholar-data
